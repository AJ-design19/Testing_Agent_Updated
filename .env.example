# ── SAI Platform Credentials ──────────────────────────────────────────────────
ADYA_URL=https://vanijstaging.adya.ai
ADYA_EMAIL=your-email@example.com
ADYA_PASSWORD=your-password

# ── LLM API (used by AnswerEngine + LLM Judge) ────────────────────────────────
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.x.ai/v1

# ── Model selection ────────────────────────────────────────────────────────────
# Model for answering Psi's questions as the persona
ANSWER_MODEL=grok-3-beta

# Model for the LLM-as-Judge evaluation
JUDGE_MODEL=grok-3-beta

# ── Browser settings ───────────────────────────────────────────────────────────
# Set to "true" to run browser without a visible window
HEADLESS=false
